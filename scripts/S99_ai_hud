#!/bin/sh
# AI-HUD auto-start script for Buildroot init.d
#
# Stability features (retail device):
#   - Watchdog respawn loops for both processes
#   - Log rotation (max 1MB per file, keeps 1 backup)
#   - Clears stale .pyc on startup (no RTC on device)
#   - Graceful SIGTERM before SIGKILL
#   - PID validation before kill to prevent PID-reuse accidents
#
# Boot sequence:
#   1. Kill rkipc / demo processes that occupy camera/display
#   2. Start ai-hud (C binary: camera -> NPU -> IPC)
#   3. Start hud_live.py (Python: GPS + IPC -> framebuffer display)
#
# Note: Splash screen is handled by S01_ai_hud_splash (earliest init).

AI_HUD="/root/ai-hud"
AI_HUD_MODEL="/root/model/speed_signs_rv1106.rknn"
AI_HUD_MODEL_FALLBACK="/root/model/au_speed_signs_rv1106.rknn"
AI_HUD_PIDFILE="/var/run/ai_hud_c.pid"

HUD_PY="/root/hud_live.py"
HUD_PY_ARGS="/dev/ttyS4 9600"
HUD_PY_PIDFILE="/var/run/ai_hud_py.pid"

WATCHDOG_C_PID="/var/run/ai_hud_watchdog_c.pid"
WATCHDOG_PY_PID="/var/run/ai_hud_watchdog_py.pid"

WATCHDOG_SYS_PID="/var/run/ai_hud_watchdog_sys.pid"

LOGFILE="/var/log/ai_hud.log"
LOGFILE_C="/var/log/ai_hud_c.log"
SPLASH_BIN="/root/splash_raw.bin"
FB_DEV="/dev/fb0"

# Max log size in bytes (1 MB)
LOG_MAX_SIZE=1048576

# Respawn delay (seconds) after crash
RESPAWN_DELAY=3

# Crash-loop backoff: if a process crashes >=N times within W seconds, slow
# respawn to BACKOFF_DELAY to avoid CPU/log thrashing. Reset on stable run.
CRASH_BURST_THRESHOLD=5
CRASH_BURST_WINDOW=30
BACKOFF_DELAY=60

# System watchdog: reboot if Python heartbeat stale for this long.
# Timeout was 90s but that's aggressive on a 1.2GHz ARM A7 -- a GC pause,
# touch I2C stall, or RKAIQ ISP reconfigure can legitimately stall the
# render loop for tens of seconds. 150s gives Python a real recovery
# window before we kick the box.
HEARTBEAT_FILE="/tmp/ai_hud_heartbeat"
HEARTBEAT_TIMEOUT=150
HEARTBEAT_CHECK=10
HEARTBEAT_GRACE=120

# Persisted across reboots so the next boot can log why we restarted.
# Lives on /userdata (separate ext4 partition) -- survives rootfs fsck.
REBOOT_REASON_FILE="/userdata/last_reboot_reason.txt"

# Ensure RKMPI libraries are in the search path (init.d may not inherit profile)
export LD_LIBRARY_PATH="/oem/usr/lib:/oem/lib:${LD_LIBRARY_PATH}"

# HUD region: "au" (Australia) or "cn" (China)
# GPS auto-detects region, this sets the default before first GPS fix
# Testing: default CN; production: change to "au"
export HUD_REGION="${HUD_REGION:-cn}"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOGFILE"
}

rotate_log() {
    # Rotate a log file if it exceeds LOG_MAX_SIZE
    _logfile="$1"
    if [ -f "$_logfile" ]; then
        _size=$(wc -c < "$_logfile" 2>/dev/null || echo 0)
        if [ "$_size" -gt "$LOG_MAX_SIZE" ]; then
            mv -f "$_logfile" "${_logfile}.old"
            log "Rotated $_logfile ($_size bytes)"
        fi
    fi
}

clear_pyc() {
    # Device has no RTC; Python can't reliably check .pyc timestamps.
    # Remove all .pyc files on every boot to ensure fresh bytecode.
    find /root -name '*.pyc' -delete 2>/dev/null
    find /root -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null
}

cleanup_ipc_files() {
    # Unified IPC cleanup used by both start() and stop().
    # Keeping these in sync prevents stale display_mode/npu_enable from a
    # previous (possibly crashed) run leaking into a fresh boot.
    rm -f /tmp/ai_hud_ready /tmp/ai_hud_detect /tmp/ai_hud_speed \
          /tmp/ai_hud_npu_enable /tmp/ai_hud_gps /tmp/ai_hud_display_mode \
          /tmp/ai_hud_pip_hide /tmp/ai_hud_heartbeat /tmp/ai_hud_isp_config
}

# Poll-wait for ALL given pids to exit, up to timeout seconds.
# Returns 0 if all exited, 1 if any still alive after timeout.
# 固定 sleep 2 后 SIGKILL 会打死还在释放 ISP/VPSS/V4L2 的进程，导致下次
# 启动撞到 device busy。所以这里 TERM 后并行 poll，能等就多等。
wait_for_pids_exit() {
    _timeout="$1"; shift
    _elapsed=0
    while [ "$_elapsed" -lt "$_timeout" ]; do
        _alive=0
        for _p in "$@"; do
            [ -n "$_p" ] && [ -d "/proc/$_p" ] && _alive=1
        done
        [ "$_alive" = "0" ] && return 0
        sleep 1
        _elapsed=$((_elapsed + 1))
    done
    return 1
}

kill_display_blockers() {
    # Stop processes that may occupy the camera or display
    for proc in rkipc simple_vi_get_frame_send_vo_rv1106; do
        if pidof "$proc" > /dev/null 2>&1; then
            log "Stopping $proc ..."
            killall "$proc" > /dev/null 2>&1
            sleep 1
        fi
    done
}

show_splash() {
    if [ -f "$SPLASH_BIN" ] && [ -e "$FB_DEV" ]; then
        log "Displaying splash screen"
        cat "$SPLASH_BIN" > "$FB_DEV"
    else
        log "WARNING: splash ($SPLASH_BIN) or framebuffer ($FB_DEV) not found, skipping splash"
    fi
}

clear_screen() {
    # Wrap dd in a background-kill sentinel so stop() returns within ~3s
    # even if the framebuffer driver is wedged (e.g., RKMPI cleanup race).
    # /dev/fb0 is 480x480*4 = 921600 bytes; count=900 (KB) covers it exactly.
    if [ -e "$FB_DEV" ]; then
        dd if=/dev/zero of="$FB_DEV" bs=1k count=900 2>/dev/null &
        _dd_pid=$!
        ( sleep 3; kill -KILL "$_dd_pid" 2>/dev/null ) &
        _killer_pid=$!
        wait "$_dd_pid" 2>/dev/null
        kill "$_killer_pid" 2>/dev/null
    fi
}

# Safe kill: verify PID matches expected process name before killing
safe_kill() {
    _pidfile="$1"
    _procname="$2"
    _signal="${3:-TERM}"

    [ -f "$_pidfile" ] || return 1
    _pid=$(cat "$_pidfile" 2>/dev/null)
    [ -n "$_pid" ] || return 1

    # Verify the PID is still the expected process (prevent PID-reuse kills)
    if [ -d "/proc/$_pid" ]; then
        _cmdline=$(cat "/proc/$_pid/cmdline" 2>/dev/null | tr '\0' ' ')
        case "$_cmdline" in
            *"$_procname"*) kill -"$_signal" "$_pid" 2>/dev/null; return 0 ;;
        esac
    fi
    return 1
}

# Compute respawn delay after a crash, applying exponential backoff if the
# process is crashing repeatedly within CRASH_BURST_WINDOW. The caller passes
# in the previous crash counter and timestamp by reference (via stdout) so the
# function stays stateless and shell-portable.
#
# Usage: read NEW_COUNT NEW_TS NEW_DELAY <<< "$(crash_backoff "$name" "$last_count" "$last_ts")"
crash_backoff() {
    _name="$1"
    _last_count="$2"
    _last_ts="$3"
    _now=$(date +%s)
    if [ "$((_now - _last_ts))" -lt "$CRASH_BURST_WINDOW" ]; then
        _new_count=$((_last_count + 1))
    else
        _new_count=1
    fi
    if [ "$_new_count" -ge "$CRASH_BURST_THRESHOLD" ]; then
        _delay="$BACKOFF_DELAY"
        log "$_name crashed $_new_count times rapidly, backing off to ${_delay}s"
    else
        _delay="$RESPAWN_DELAY"
    fi
    echo "$_new_count $_now $_delay"
}

# Watchdog loop: restart process on crash
watchdog_c() {
    _crash_count=0
    _last_crash_ts=0
    while true; do
        _model=""
        if [ -f "$AI_HUD_MODEL" ]; then
            _model="$AI_HUD_MODEL"
        elif [ -f "$AI_HUD_MODEL_FALLBACK" ]; then
            _model="$AI_HUD_MODEL_FALLBACK"
        fi

        # If ai-hud dies < 5s in, it's almost certainly an ISP/V4L2 race
        # from the previous instance -- needs longer settle than runtime crash.
        _start_ts=$(date +%s)

        if [ -x "$AI_HUD" ] && [ -n "$_model" ]; then
            "$AI_HUD" --model "$_model" >> "$LOGFILE_C" 2>&1 &
            _pid=$!
            echo "$_pid" > "$AI_HUD_PIDFILE"
            log "ai-hud started PID=$_pid (with model: $_model)"
            wait "$_pid"
        elif [ -x "$AI_HUD" ]; then
            "$AI_HUD" >> "$LOGFILE_C" 2>&1 &
            _pid=$!
            echo "$_pid" > "$AI_HUD_PIDFILE"
            log "WARNING: model not found ($AI_HUD_MODEL or $AI_HUD_MODEL_FALLBACK)"
            log "ai-hud started PID=$_pid (display-only)"
            wait "$_pid"
        else
            log "WARNING: $AI_HUD not found, watchdog_c sleeping"
            sleep 60
            continue
        fi
        _exit=$?
        _run_dur=$(( $(date +%s) - _start_ts ))
        set -- $(crash_backoff "ai-hud" "$_crash_count" "$_last_crash_ts")
        _crash_count="$1"; _last_crash_ts="$2"; _delay="$3"

        # Short-lifetime crash -> bump delay so V4L2/MIPI can finish releasing.
        # Skip if backoff already raised delay above 8s.
        if [ "$_run_dur" -lt 5 ] && [ "$_delay" -lt 8 ]; then
            _delay=8
            log "ai-hud died after ${_run_dur}s (likely ISP init race), using ${_delay}s settle"
        fi

        log "ai-hud exited with code $_exit, restarting in ${_delay}s"
        rotate_log "$LOGFILE_C"
        sleep "$_delay"
    done
}

watchdog_py() {
    _crash_count=0
    _last_crash_ts=0
    while true; do
        if [ -f "$HUD_PY" ]; then
            python3 -u "$HUD_PY" $HUD_PY_ARGS >> "$LOGFILE" 2>&1 &
            _pid=$!
            echo "$_pid" > "$HUD_PY_PIDFILE"
            log "hud_live.py started PID=$_pid"
            wait "$_pid"
        else
            log "ERROR: $HUD_PY not found, watchdog_py sleeping"
            sleep 60
            continue
        fi
        _exit=$?
        set -- $(crash_backoff "hud_live.py" "$_crash_count" "$_last_crash_ts")
        _crash_count="$1"; _last_crash_ts="$2"; _delay="$3"
        log "hud_live.py exited with code $_exit, restarting in ${_delay}s"
        rotate_log "$LOGFILE"
        sleep "$_delay"
    done
}

# Capture process snapshot for the next-boot forensic log, then attempt
# a clean reboot, falling back to forced reboot if init doesn't shut down
# in time. Without CONFIG_MAGIC_SYSRQ + hardware watchdog there is no
# safety net beyond `reboot -f`; if the kernel reset path itself is wedged
# (e.g. RKAIQ holding ISP/MIPI locks during machine_restart), only a
# physical power-cycle recovers. P0 follow-up is to enable DW_WATCHDOG.
trigger_watchdog_reboot() {
    _heartbeat_age="$1"
    _c_pid=$(pidof ai-hud 2>/dev/null)
    _py_pid=$(pidof python3 2>/dev/null)

    log "WATCHDOG: heartbeat stale ${_heartbeat_age}s (threshold=${HEARTBEAT_TIMEOUT}s)"
    log "WATCHDOG: snapshot ai-hud=${_c_pid:-none} python3=${_py_pid:-none}"

    # Forensic trail for the NEXT boot.   We write this BEFORE rebooting
    # so a `reboot -f` that succeeds still leaves the reason on disk.
    # /userdata is a separate ext4 partition; survives rootfs fsck.
    {
        echo "ts=$(date +%s)"
        echo "wall=$(date '+%Y-%m-%d %H:%M:%S')"
        echo "trigger=heartbeat_stale"
        echo "heartbeat_age=${_heartbeat_age}"
        echo "threshold=${HEARTBEAT_TIMEOUT}"
        echo "ai_hud_pid=${_c_pid:-none}"
        echo "py_pid=${_py_pid:-none}"
        # Capture top 5 cpu hogs (best-effort; ps may be slow under hang).
        ps 2>/dev/null | head -6
    } > "$REBOOT_REASON_FILE" 2>/dev/null
    sync   # flush both the reason file and pending HUD logs

    # Phase 1 -- graceful: SIGTERM init -> rcK -> umount.  Init runs
    # ::shutdown lines from /etc/inittab.  5s budget: enough for a clean
    # exit, short enough that we still recover if rcK hangs on stop().
    log "WATCHDOG: graceful reboot (5s budget)"
    reboot &
    _reboot_helper=$!
    sleep 5

    # Phase 2 -- forced: if init didn't shut us down, fall through to the
    # kernel reboot syscall directly.  This skips umount but the journal
    # has been sync'd, so rootfs comes back clean on next boot.
    if [ -d "/proc/$$" ]; then
        log "WATCHDOG: graceful reboot did not take, forcing"
        sync
        reboot -f
    fi
    # Reached only if both reboot calls failed.   Loop forever so the
    # watchdog process doesn't exit (and respawn worker traffic) on a
    # device that's already in a bad state -- physical reset needed.
    while true; do sleep 60; done
}

# System-level watchdog: reboot device if Python heartbeat goes stale.
# Catches application-level deadlocks where processes don't crash but
# stop responding (e.g., RKMPI driver hang, Python GIL deadlock).
# NOTE: Cannot recover from kernel-level freezes (needs CONFIG_DW_WATCHDOG).
system_watchdog() {
    # Wait grace period for processes to start and write first heartbeat
    sleep "$HEARTBEAT_GRACE"

    while true; do
        sleep "$HEARTBEAT_CHECK"

        # Read heartbeat timestamp (shell builtin, no fork)
        read _hb_ts < "$HEARTBEAT_FILE" 2>/dev/null || continue
        [ -n "$_hb_ts" ] || continue

        _now=$(date +%s)
        _age=$(( _now - _hb_ts ))

        if [ "$_age" -gt "$HEARTBEAT_TIMEOUT" ]; then
            trigger_watchdog_reboot "$_age"
        fi

        # Piggyback periodic log rotation onto this 10s heartbeat loop.
        # rotate_log() is a no-op until the file passes LOG_MAX_SIZE (1 MB),
        # so this is cheap. Without this, a stable long-running device
        # (HUD never crashes, never restarts) would never rotate -- worst
        # case observed in long testing was ai_hud.log growing into the
        # tens of MB and starting to eat into the rootfs free space.
        rotate_log "$LOGFILE"
        rotate_log "$LOGFILE_C"
    done
}

# If the previous boot ended via watchdog reboot, surface why. Read,
# log, and move aside so we keep at most one historical record on disk.
log_last_reboot_reason() {
    [ -f "$REBOOT_REASON_FILE" ] || return 0
    log "===== Previous boot ended via watchdog reboot ====="
    while IFS= read -r _line; do
        log "  $_line"
    done < "$REBOOT_REASON_FILE"
    # Archive (not delete) so a sequence of bad boots can be inspected
    # via /userdata/last_reboot_reason.txt.prev.
    mv -f "$REBOOT_REASON_FILE" "${REBOOT_REASON_FILE}.prev" 2>/dev/null
}

# pkill workers by name with graceful TERM + settle + KILL. Cheap no-op
# when nothing is running, so it's safe to call as a defensive cleanup
# step. Used by both stop() (orphan fallback) and start() (residue
# handling on manual hot-start).
pkill_workers_orphan() {
    pgrep -f "ai-hud" > /dev/null 2>&1 || pgrep -f "hud_live.py" > /dev/null 2>&1 || return 0
    log "WARN: orphan worker(s) detected, cleaning up"
    pkill -TERM -f "ai-hud" 2>/dev/null
    pkill -TERM -f "hud_live.py" 2>/dev/null
    sleep 2  # kernel V4L2/MIPI/ISP release window
    pkill -KILL -f "ai-hud" 2>/dev/null
    pkill -KILL -f "hud_live.py" 2>/dev/null
}

start() {
    log "===== START ====="

    # 1. Kill leftover watchdogs first so they can't respawn workers
    #    during the cleanup below. Watchdog subshells inherit the parent
    #    init.d cmdline, so safe_kill matches "S99_ai_hud" (NOT "watchdog").
    safe_kill "$WATCHDOG_SYS_PID" "S99_ai_hud" TERM
    safe_kill "$WATCHDOG_C_PID" "S99_ai_hud" TERM
    safe_kill "$WATCHDOG_PY_PID" "S99_ai_hud" TERM
    sleep 1
    safe_kill "$WATCHDOG_SYS_PID" "S99_ai_hud" KILL
    safe_kill "$WATCHDOG_C_PID" "S99_ai_hud" KILL
    safe_kill "$WATCHDOG_PY_PID" "S99_ai_hud" KILL

    # 2. Defensive worker residue cleanup. In the restart/cold-boot path
    #    stop() (or buildroot) already cleaned everything, so pgrep
    #    returns no match and we pay zero seconds. The sleep only fires
    #    if a manual hot-start finds live workers.
    pkill_workers_orphan

    rm -f "$AI_HUD_PIDFILE" "$HUD_PY_PIDFILE"
    rm -f "$WATCHDOG_C_PID" "$WATCHDOG_PY_PID" "$WATCHDOG_SYS_PID"
    cleanup_ipc_files

    rotate_log "$LOGFILE"
    rotate_log "$LOGFILE_C"
    log_last_reboot_reason
    clear_pyc
    kill_display_blockers

    # Paint splash now: covers any half-frame left by a crashed worker
    # and stays on screen until Python's first render replaces it.
    show_splash

    watchdog_c &
    echo $! > "$WATCHDOG_C_PID"
    sleep 2  # let ai-hud bring up VI/VPSS before Python opens fb0

    watchdog_py &
    echo $! > "$WATCHDOG_PY_PID"

    system_watchdog &
    echo $! > "$WATCHDOG_SYS_PID"

    log "Watchdogs started: C=$(cat $WATCHDOG_C_PID) Py=$(cat $WATCHDOG_PY_PID) Sys=$(cat $WATCHDOG_SYS_PID)"
}

stop() {
    log "===== STOP ====="

    # 1. Stop watchdog loops first (prevent respawn during shutdown).
    safe_kill "$WATCHDOG_SYS_PID" "S99_ai_hud" TERM
    safe_kill "$WATCHDOG_C_PID" "S99_ai_hud" TERM
    safe_kill "$WATCHDOG_PY_PID" "S99_ai_hud" TERM
    sleep 1
    safe_kill "$WATCHDOG_SYS_PID" "S99_ai_hud" KILL
    safe_kill "$WATCHDOG_C_PID" "S99_ai_hud" KILL
    safe_kill "$WATCHDOG_PY_PID" "S99_ai_hud" KILL
    rm -f "$WATCHDOG_C_PID" "$WATCHDOG_PY_PID" "$WATCHDOG_SYS_PID"

    # 2. TERM both workers in parallel then poll-wait both at once.
    #    Serial graceful-stop would burn 4s+6s = 10s; parallel caps at
    #    max(4,6) = 6s. The workers are independent so this is safe.
    _py_pid=$(cat "$HUD_PY_PIDFILE" 2>/dev/null)
    _c_pid=$(cat "$AI_HUD_PIDFILE" 2>/dev/null)
    safe_kill "$HUD_PY_PIDFILE" "hud_live" TERM
    safe_kill "$AI_HUD_PIDFILE" "ai-hud" TERM
    if wait_for_pids_exit 6 "$_py_pid" "$_c_pid"; then
        log "workers exited cleanly"
    else
        log "WARN: worker(s) did not exit in 6s, SIGKILL"
        safe_kill "$HUD_PY_PIDFILE" "hud_live" KILL
        safe_kill "$AI_HUD_PIDFILE" "ai-hud" KILL
        sleep 1  # kernel reap window after KILL
    fi

    # 3. Orphan fallback for processes not tracked by pidfile.
    pkill_workers_orphan

    rm -f "$AI_HUD_PIDFILE" "$HUD_PY_PIDFILE"
    cleanup_ipc_files

    # 4. Kernel V4L2/MIPI/ISP char devices need time to fully release
    #    after the last close; without this margin a back-to-back
    #    start() hits "device busy" on VI EnableDev / sysctl_init.
    sleep 2

    log "Stopped"
}

restart() {
    stop
    # Repaint splash so the user sees the brand image instead of stale
    # frame or black while start() initializes. stop() intentionally
    # leaves fb0 alone -- visual policy is the caller's responsibility.
    show_splash
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        clear_screen
        ;;
    restart)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
