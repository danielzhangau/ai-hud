#!/bin/sh
# AI-HUD auto-start script for Buildroot init.d
#
# Boot sequence:
#   1. Kill rkipc / demo processes that occupy camera/display
#   2. Show splash screen for 3 seconds
#   3. Start ai-hud (C binary: camera -> NPU -> IPC)
#   4. Start hud_live.py (Python: GPS + IPC -> framebuffer display)

AI_HUD="/root/ai-hud"
AI_HUD_MODEL="/root/model/yolov5n_rv1106.rknn"
AI_HUD_PIDFILE="/var/run/ai_hud_c.pid"

HUD_PY="/root/hud_live.py"
HUD_PY_ARGS="/dev/ttyS4 9600"
HUD_PY_PIDFILE="/var/run/ai_hud_py.pid"

LOGFILE="/var/log/ai_hud.log"
SPLASH_BIN="/root/splash_raw.bin"
FB_DEV="/dev/fb0"

# Ensure RKMPI libraries are in the search path (init.d may not inherit profile)
export LD_LIBRARY_PATH="/oem/usr/lib:/oem/lib:${LD_LIBRARY_PATH}"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOGFILE"
}

kill_display_blockers() {
    # Stop processes that may occupy the camera or display
    for proc in rkipc simple_vi_get_frame_send_vo_rv1106; do
        if pidof "$proc" > /dev/null 2>&1; then
            log "Stopping $proc ..."
            killall "$proc" > /dev/null 2>&1
            sleep 1
        fi
    done
}

show_splash() {
    if [ -f "$SPLASH_BIN" ] && [ -e "$FB_DEV" ]; then
        log "Displaying splash screen"
        cat "$SPLASH_BIN" > "$FB_DEV"
    else
        log "WARNING: splash ($SPLASH_BIN) or framebuffer ($FB_DEV) not found, skipping splash"
    fi
}

clear_screen() {
    if [ -e "$FB_DEV" ]; then
        log "Clearing framebuffer"
        dd if=/dev/zero of="$FB_DEV" bs=1k 2>/dev/null
    fi
}

start() {
    log "===== START ====="

    # Make sure display-blocking processes are stopped first
    kill_display_blockers

    # Show splash screen and hold for 3 seconds
    show_splash
    sleep 3

    # Launch ai-hud C binary (camera + NPU inference pipeline)
    if [ -x "$AI_HUD" ] && [ -f "$AI_HUD_MODEL" ]; then
        log "Starting $AI_HUD --model $AI_HUD_MODEL"
        ( nohup "$AI_HUD" --model "$AI_HUD_MODEL" >> "$LOGFILE" 2>&1 & echo $! > "$AI_HUD_PIDFILE" )
        sleep 2  # Wait for camera pipeline to initialize
        log "ai-hud started with PID $(cat $AI_HUD_PIDFILE 2>/dev/null)"
    elif [ -x "$AI_HUD" ]; then
        # No model file: run display-only mode
        log "Starting $AI_HUD (display-only, no model)"
        ( nohup "$AI_HUD" >> "$LOGFILE" 2>&1 & echo $! > "$AI_HUD_PIDFILE" )
        sleep 2
        log "ai-hud started with PID $(cat $AI_HUD_PIDFILE 2>/dev/null)"
    else
        log "WARNING: $AI_HUD not found, skipping camera pipeline"
    fi

    # Launch hud_live.py (GPS HUD + NPU result display)
    if [ -f "$HUD_PY" ]; then
        log "Starting $HUD_PY $HUD_PY_ARGS"
        ( nohup python3 "$HUD_PY" $HUD_PY_ARGS >> "$LOGFILE" 2>&1 & echo $! > "$HUD_PY_PIDFILE" )
        log "hud_live.py started with PID $(cat $HUD_PY_PIDFILE 2>/dev/null)"
    else
        log "ERROR: $HUD_PY not found, cannot start HUD display"
    fi
}

stop() {
    log "===== STOP ====="

    # Stop hud_live.py first (it writes to framebuffer)
    if [ -f "$HUD_PY_PIDFILE" ]; then
        kill "$(cat $HUD_PY_PIDFILE)" 2>/dev/null
        sleep 1
        kill -9 "$(cat $HUD_PY_PIDFILE)" 2>/dev/null
        rm -f "$HUD_PY_PIDFILE"
        log "Stopped hud_live.py"
    else
        pkill -f "hud_live.py" 2>/dev/null
    fi

    # Stop ai-hud (camera + NPU pipeline)
    if [ -f "$AI_HUD_PIDFILE" ]; then
        kill "$(cat $AI_HUD_PIDFILE)" 2>/dev/null
        sleep 2  # Give RKMPI time to clean up
        kill -9 "$(cat $AI_HUD_PIDFILE)" 2>/dev/null
        rm -f "$AI_HUD_PIDFILE"
        log "Stopped ai-hud"
    else
        pkill -f "ai-hud" 2>/dev/null
    fi

    # Clear the framebuffer to black
    clear_screen
    log "Stopped"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
