<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>AI-HUD Config</string>
    <key>CFBundleDisplayName</key>
    <string>AI-HUD Config</string>
    <key>CFBundleIdentifier</key>
    <string>com.danielzhangau.ai-hud.config</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleExecutable</key>
    <string>launch</string>
    <key>CFBundleIconFile</key>
    <string>AI-HUD</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Background app: no Dock icon, no menu bar. The launcher pops a
         browser window and exits within a couple of seconds; a Dock icon
         would just flicker. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Required for Apple Silicon notarization metadata; harmless on Intel. -->
    <key>LSArchitecturePriority</key>
    <array>
        <string>arm64</string>
        <string>x86_64</string>
    </array>
</dict>
</plist>
